rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuth() && ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /savedGames/{docId} {
      allow read, delete: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuth() 
        && resource.data.hostUid == request.auth.uid 
        && request.resource.data.hostUid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
